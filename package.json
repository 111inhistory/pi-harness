{
  "name": "pi-harness",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "Capability discovery and Subagent execution for Pi, with optional Shell checks and approval",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/result-rendering.ts",
      "./extensions/subagent.ts",
      "./extensions/capability.ts",
      "./extensions/btw.ts",
      "./extensions/preset.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "license:generate": "npm exec --yes --package=license@1.0.3 -- license MPL-2.0 --raw --name=\"Pi Harness contributors\" --email=\"\" > LICENSE",
    "build:async-shell": "node scripts/build-async-shell.mjs",
    "install:async-shell": "npm run build:async-shell && node scripts/install-async-shell.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/test.mjs",
    "test:typed": "node --import tsx scripts/test.mjs typed",
    "check": "npm run typecheck && npm test",
    "check:json": "node scripts/check-json.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:test-contracts": "node scripts/check-test-contracts.mjs --staged",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:subagent": "node --import tsx --test test/subagent-runtime.test.mjs",
    "test:shell-preflight": "node --import tsx --test test/shell-preflight.test.mjs test/shell-preflight-extension.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.0",
    "minisearch": "7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.5.0 <1.6.0",
    "@earendil-works/pi-ai": ">=1.5.0 <1.6.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0 <1.6.0"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "22.19.19",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@mzwing/pi-permission-auto-review": "1.0.1"
  }
}
