{
  "name": "pi-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Capability discovery and Subagent execution for Pi, with optional Shell Preflight",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": ["./extensions/harness.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/test.mjs",
    "test:typed": "node --import tsx scripts/test.mjs typed",
    "check": "npm run typecheck && npm test",
    "check:json": "node scripts/check-json.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:subagent": "node --import tsx --test test/subagent-runtime.test.mjs",
    "test:shell-preflight": "node --import tsx --test test/shell-preflight.test.mjs test/shell-preflight-extension.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.5.0",
    "minisearch": "7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "overrides": {
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
