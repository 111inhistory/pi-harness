#!/usr/bin/env sh
set -e

cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged
fi

# Contract associations are advisory; secret scanning above remains blocking.
if ! node scripts/check-test-contracts.mjs --staged; then
  printf '%s\n' 'Contract reminder only: commit will continue. Review potential mismatches when useful.' >&2
fi
